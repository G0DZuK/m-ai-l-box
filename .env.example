# M-Ai-L Box configuration. Copy to .env and edit. This file contains NO secrets — generate your own.
# List values are JSON arrays, e.g. RECEIVING_DOMAINS=["inbox.example.com","qa.example.com"]

ENVIRONMENT=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me-before-deploying
LOG_LEVEL=INFO

# ---- Receiving --------------------------------------------------------------------------------
# Domains you own and have pointed at your inbound provider (the first one is the default).
# For local use any name works because mail is sent straight to localhost:2525.
RECEIVING_DOMAINS=["mailbox.localhost"]
# Which inbound adapters are enabled: smtp (built-in receiver), cloudflare (Email Worker → /api/inbound/raw),
# mailgun (Routes → /api/inbound/mailgun/mime)
INBOUND_ADAPTERS=["smtp"]
# reject = refuse mail for unknown/expired addresses (SMTP 550 / webhook 404|406); discard = accept and drop
UNKNOWN_RECIPIENT_POLICY=reject
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_HOSTNAME=mx.mailbox.localhost
# Optional STARTTLS for the built-in receiver (PEM paths inside the container)
SMTP_TLS_CERT=
SMTP_TLS_KEY=
# Shared secret for the Cloudflare Email Worker (must match the Worker's INBOUND_WEBHOOK_SECRET)
INBOUND_WEBHOOK_SECRET=
# Mailgun → Settings → API Security → "HTTP webhook signing key"
MAILGUN_WEBHOOK_SIGNING_KEY=

# ---- Storage ----------------------------------------------------------------------------------
# docker-compose.yml already points these at the bundled PostgreSQL / Redis / MinIO.
# DATABASE_URL=postgresql+psycopg://mailbox:mailbox@localhost:5432/mailbox
# REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=s3
S3_REGION=us-east-1
S3_BUCKET=mailbox
# MinIO credentials used by docker-compose (local only — change for anything reachable)
MINIO_ROOT_USER=mailbox
MINIO_ROOT_PASSWORD=change-me-local-minio-password

# ---- Limits (bytes) ---------------------------------------------------------------------------
# 25 MB per message. MIME/base64 encoding adds ~33%, so the largest attachment that fits is ~18 MB.
MAX_MESSAGE_BYTES=26214400
MAX_UPLOAD_BYTES=26214400
TEMP_MAILBOX_MAX_MESSAGES=200
TEMP_MAILBOX_QUOTA_BYTES=104857600
USER_QUOTA_BYTES=1073741824
CUSTOM_LOCAL_PART_ALLOWED=true

# ---- Retention --------------------------------------------------------------------------------
TEMP_MAILBOX_TTL_HOURS=24
TRASH_RETENTION_DAYS=7
# 0 = keep messages in saved mailboxes until the user deletes them
SAVED_MESSAGE_RETENTION_DAYS=0
DELIVERY_LOG_RETENTION_DAYS=14

# ---- Accounts & abuse controls ----------------------------------------------------------------
ACCOUNTS_ENABLED=true
REGISTRATION_OPEN=true
SESSION_TTL_DAYS=30
RL_MAILBOX_CREATE_PER_HOUR=20
RL_API_PER_MINUTE=300
RL_AUTH_PER_MINUTE=10
RL_INBOUND_PER_MAILBOX_PER_HOUR=300
RL_INBOUND_PER_IP_PER_MINUTE=120
RL_UPLOAD_PER_HOUR=120
# Only enable behind a reverse proxy you control (Caddy in docker-compose.prod.yml sets it)
TRUST_PROXY_HEADERS=false

# ---- Misc -------------------------------------------------------------------------------------
DOWNLOAD_LINK_TTL_SECONDS=120
WAIT_MAX_SECONDS=120
# DEMO MODE: offers a "Try demo mailbox" button that fills a mailbox with locally generated SAMPLE
# messages. Samples are labelled everywhere and prove nothing about real e-mail delivery.
DEMO_MODE=true
# Malware scanning: none | clamav  (start the clamav profile: docker compose --profile clamav up)
SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Production only --------------------------------------------------------------------------
# Public hostname for the web UI (used by docker-compose.prod.yml / Caddy)
APP_DOMAIN=
